# Copy this file to .env and fill in your own values:
#   cp .env.example .env
#
# .env is read automatically by `docker compose` - never commit the real
# .env file (only .env.example) since DOCKYARD_INGEST_TOKEN is a secret.

# Wherever your central Dockyard instance runs. Use https:// in production -
# the ingest token is sent as a bearer token on every push, so plain http://
# means that token (and your compose file contents) cross the network in
# clear text.
DOCKYARD_URL=https://dockyard.<YOUR_DOMAIN>

# Must match the central instance's own DOCKYARD_INGEST_TOKEN exactly.
# Generate a long random value, e.g.: openssl rand -hex 32
DOCKYARD_INGEST_TOKEN=<SET A LONG RANDOM SECRET HERE>

# Must match this host's "name" in the central instance's DOCKYARD_HOSTS.
DOCKYARD_HOST_NAME=prod-server

# Push on a loop every N seconds. Set to 0 instead to push once and exit
# (for an external cron job/systemd timer) - see the restart: note in
# docker-compose.yml if you do this.
PUSH_INTERVAL=300

# Where this server's own compose files live. Read-only is enforced in
# docker-compose.yml regardless of what's writable here.
# HOST_COMPOSE_DIR=/home/dev/docker
HOST_COMPOSE_DIR=/srv/docker

# Optional: the docker-socket-proxy service is active by default but bound to
# 127.0.0.1, so it's harmless but not reachable from your central Dockyard
# instance until you set this to a real LAN IP. Read the security notes in
# docker-compose.yml before setting it - a Docker API, even read-only, needs
# real thought about what can reach it. If you don't want the proxy at all,
# delete that service and the "networks:" section from docker-compose.yml.
# PROXY_BIND_IP=192.168.1.50
